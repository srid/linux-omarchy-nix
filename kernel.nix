# linux-omarchy, built from the PKGBUILD tree that the `omarchy-pkgs` input pins.
#
# The patch set (~188 patches) and the kernel config come from that input at
# build time, so this file only carries the kernel.org tarball and the version —
# both regenerated by `just update` (see sources.nix).
#
# Note: NixOS wraps the kernel package as `kernel.override (args: { features,
# kernelPatches, ... })`, so extra arguments are accepted and ignored; the patch
# set is fixed by the input. Do not name an argument `kernelPatches`:
# `callPackage` would auto-fill it with nixpkgs' `linux-kernel-patches` attrset.
{
  pkgs,
  omarchy-pkgs,
  features ? { },
  ...
}:
let
  dir = "${omarchy-pkgs}/pkgbuilds/linux-omarchy";
  sources = import ./sources.nix;

  # Every .patch in the PKGBUILD directory; the numeric prefixes make
  # lexicographic order the apply order.
  patches = builtins.filter (n: builtins.match ".*\\.patch" n != null) (
    builtins.attrNames (builtins.readDir dir)
  );

  major = builtins.head (builtins.split "\\." sources.version);
in
pkgs.buildLinux {
  inherit features;
  inherit (sources) version;
  modDirVersion = sources.version;

  src = pkgs.fetchurl {
    url = "https://cdn.kernel.org/pub/linux/kernel/v${major}.x/linux-${sources.version}.tar.xz";
    hash = sources.srcHash;
  };

  configfile = "${dir}/config.x86_64";

  kernelPatches = map (p: {
    name = p;
    patch = "${dir}/${p}";
  }) patches;

  extraMeta = {
    branch = "${major}.x";
    description = "Omarchy kernel (BORE scheduler, ADIOS I/O scheduler)";
    homepage = "https://omarchy.org";
    license = pkgs.lib.licenses.gpl2Only;
  };
}
